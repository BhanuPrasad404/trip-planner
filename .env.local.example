# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Public origin of the deployed site (used for SEO + auth email redirects).
# Local dev can leave this as is.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Smart Import / Trip Brief (optional; Google Maps-link imports work without it) ──
# Get a key at https://console.anthropic.com  — never prefix with NEXT_PUBLIC_.
# Put it on this line with NO quotes/spaces, then STOP and RESTART `npm run dev` (Next.js reads this file only at start).
# Not sure it works? Profile → Setup check → "Test my AI key" tells you exactly what is wrong.
# ── AI import (pick ONE provider; the first key found is used, or set AI_PROVIDER=anthropic|gemini|openai) ──
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Max AI-backed imports per user per 24h (protects your bill)
IMPORT_DAILY_LIMIT=40

# Nominatim (OpenStreetMap geocoder) requires a contact in the User-Agent. Use your email/site.
GEOCODER_USER_AGENT=Trailmate/1.0 (you@example.com)

# ── Optional production upgrades ──
# OSRM_BASE_URL=https://your-osrm-or-routing-provider
# NEXT_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/streets/style.json?key=YOUR_KEY

# Place-search limit per user per 24h (the free geocoder is rate-limited)
# GEOCODE_DAILY_LIMIT=150

# ── Trip Intelligence / our own places database ─────────────────────────────
# SERVER-ONLY secret (Supabase → Project Settings → API → "service_role"). NEVER put NEXT_PUBLIC_ in front of it.
# It lets the server fill our places database. Without it everything still works, but places are kept in memory only
# (lost on restart, not shared between servers).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: lets you pre-load a whole region with `node scripts/ingest-region.mjs` (at least 16 random characters).
# If empty, the /api/admin/ingest route does not exist.
INGEST_SECRET=

# ── Swap a vendor without changing code (defaults shown) ────────────────────
# ROUTING_PROVIDER=osrm
# PLACES_PROVIDER=osm
# WEATHER_PROVIDER=open-meteo
# GEOCODING_PROVIDER=nominatim
# Map tiles: any MapLibre style URL (MapTiler, Stadia, Mapbox, self-hosted):
# NEXT_PUBLIC_MAP_STYLE_URL=
# Your own Overpass / OSRM servers for production scale:
# OVERPASS_URL=
# OSRM_BASE_URL=

# ── Map ─────────────────────────────────────────────────────────────────────────────────────────────────────────
# Default basemap is OpenFreeMap "Liberty" (vector, 3D buildings, no key). Its public server is provided as-is and can change:
# for production self-host it (https://github.com/hyperknot/openfreemap) or use any OpenMapTiles-schema style URL here.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Optional satellite underlay: a raster tile URL you are LICENSED to use, e.g. https://example.com/{z}/{x}/{y}.jpg
# NEXT_PUBLIC_SATELLITE_TILES_URL=
# Turn-by-turn uses OSRM. The public demo server is for light testing only; set your own for real use:
# OSRM_BASE_URL=https://your-osrm.example.com

# Free option for TESTING: a Google Gemini key (no card): https://aistudio.google.com/app/apikey
# NOTE: on the free tier Google may use your requests to improve its products — do not import private content with a free key.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Any OpenAI-style service (xAI Grok, Groq, OpenRouter, OpenAI). xAI's API is prepaid — it has no permanent free tier.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.x.ai/v1
# OPENAI_MODEL=
# AI_PROVIDER=gemini
